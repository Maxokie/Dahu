    <SolidColorBrush x:Key="MaintenanceBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="ToggleCheckedBrush" Color="#FFF4E5" />
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#EEEEEE" />
    <SolidColorBrush x:Key="HeaderSortBrush" Color="#D5E0EE" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C9D1" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#A6ADB8" />

    <SolidColorBrush x:Key="AccentBrush" Color="#26466E" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="#3A6EA5" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="#26466E" />
    <SolidColorBrush x:Key="OkBrush" Color="#2E8B57" />
    <SolidColorBrush x:Key="WarnBrush" Color="#D9822B" />
    <SolidColorBrush x:Key="ErrBrush" Color="#C0392B" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#8A8F98" />

</ResourceDictionary>
