<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="BorderBrushLight" Color="#D5DBE3" />
    <SolidColorBrush x:Key="CheckBorderBrush" Color="#8C939D" />

    <SolidColorBrush x:Key="TextBrush" Color="#000000" />
    <SolidColorBrush x:Key="TextSoftBrush" Color="#333333" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#666666" />
    <SolidColorBrush x:Key="TextHintBrush" Color="#999999" />

    <SolidColorBrush x:Key="HoverBrush" Color="#E8EEF6" />
    <SolidColorBrush x:Key="PressedBrush" Color="#D5E0EE" />
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE0F5" />
    <SolidColorBrush x:Key="SelectionTextBrush" Color="#000000" />
    <SolidColorBrush x:Key="GridLineBrush" Color="#EEF1F5" />
